NODE_ENV=production
PORT=5000
CLIENT_URL=https://celesticare-deployed-client.vercel.app
# MongoDB Atlas
MONGO_URI=your_mongodb_atlas_connection_string

# Security Keys
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=1d

# Brevo SMTP Configuration
# Render Free blocks SMTP ports 25, 465, and 587. Brevo supports port 2525.
BREVO_API_KEY=your_brevo_api_key
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_password
FROM_NAME=CelestiCare
FROM_EMAIL=kele.estayo.up@phinmaed.com

# Astrology providers (keep real keys in Render Environment Variables, never in Git)
FREE_ASTRO_API_KEY=your_freeastroapi_key
FREE_ASTRO_API_URL=https://api.freeastroapi.com/api/v1/natal/calculate
GEMINI_API_KEY=your_google_gemini_api_key
